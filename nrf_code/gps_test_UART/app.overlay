/* Pin control configuration for uart0 */

&pinctrl {
    uart0_default: uart0_default {
        group1 {
        
            // Active pin state - TX on P0.06, RX on P0.11
            psels = <NRF_PSEL(UART_TX, 0, 6)>,
                    <NRF_PSEL(UART_RX, 0, 11)>;
        };
    };
    uart0_sleep: uart0_sleep {
        group1 {

            // Sleep pin state - same pins but low power mode enabled
            psels = <NRF_PSEL(UART_TX, 0, 6)>,
                    <NRF_PSEL(UART_RX, 0, 11)>;
            low-power-enable;
        };
    };
};

/* UART0 peripheral configuration - used for GPS NMEA data at 9600 baud */
&uart0 {
    status = "okay";
    current-speed = <9600>;
    // state 0: active
    pinctrl-0 = <&uart0_default>;
    // state 1: sleep
    pinctrl-1 = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";
};