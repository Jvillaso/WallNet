#include <zephyr/dt-bindings/input/input-event-codes.h>
/ {
    aliases {
        sw0 = &button0;
    };

    // whatever main control button is
    buttons {
        compatible = "gpio-keys";
        debounce-interval-ms = <50>;
        
        button0: button_0 {
            gpios = <&gpio0 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Push button switch 0";
            zephyr,code = <INPUT_KEY_0>;
        };
    };

    buzzer {
        compatible = "gpio-leds";
        buzzer0: buzzer_0 {
            gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
            label = "Buzzer";
        };
    };
};

&pinctrl {
    i2c0_default: i2c0_default {
        // gooked up to gps rn
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 26)>,
                    <NRF_PSEL(TWIM_SCL, 0, 27)>;
            bias-pull-up;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 26)>,
                    <NRF_PSEL(TWIM_SCL, 0, 27)>;
            low-power-enable;
        };
    };

    uart0_default: uart0_default {
        group1 {
        
            // Active pin state - TX on P0.06, RX on P0.11
            psels = <NRF_PSEL(UART_TX, 0, 6)>,
                    <NRF_PSEL(UART_RX, 0, 11)>;
        };
    };
    uart0_sleep: uart0_sleep {
        group1 {

            // Sleep pin state - same pins but low power mode enabled
            psels = <NRF_PSEL(UART_TX, 0, 6)>,
                    <NRF_PSEL(UART_RX, 0, 11)>;
            low-power-enable;
        };
    };
};

/* UART0 peripheral configuration - used for FP data at 115200 baud */
&uart0 {
    status = "okay";
    current-speed = <115200>;
    // state 0: active
    pinctrl-0 = <&uart0_default>;
    // state 1: sleep
    pinctrl-1 = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";
};

// i2c0: GPS 
&i2c0 {
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    compatible = "nordic,nrf-twim";

    zephyr,concat-buf-size = <512>;
    zephyr,flash-buf-max-size = <512>;
};

// i2c1/spi1: RFID

// spi2: Eink
