#include <zephyr/dt-bindings/input/input-event-codes.h>
/ {
    aliases {
        sw1 = &button1;
    };

    // whatever main control button is
    buttons {
        compatible = "gpio-keys";
        debounce-interval-ms = <50>;
        
        button1: button_1 {
            gpios = <&gpio0 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Push button switch 1";
            zephyr,code = <INPUT_KEY_1>;
        };
    };

    /* PWM-controlled buzzer */
    buzzer_pwm: pwm-buzzer {
        compatible = "pwm-leds";

        buzzer0: buzzer_0 {
            label = "Buzzer";
            pwms = <&pwm0 0 250000 125000 0>; /* PWM on pwm0, channel 0, 250000ns period, 50% duty cycle, active high */
        };
    };
};

&pwm0_default {
    group1 {
        psels = <NRF_PSEL(PWM_OUT0, 0, 12)>;
    };
};

&pwm0_sleep {
    group1 {
        psels = <NRF_PSEL(PWM_OUT0, 0, 12)>;
    };
};

&pwm0 {
    status = "okay";

    /* THIS is what selects the GPIO pin */
    pinctrl-0 = <&pwm0_default>;
    pinctrl-names = "default", "sleep";
    
};


&pinctrl {
    /* change below to bmu stuff (idk pins rn - battery schematic) */

    // i2c0_default: i2c0_default {
    //     // gooked up to gps rn
    //     group1 {
    //         psels = <NRF_PSEL(TWIM_SDA, 0, 7)>,
    //                 <NRF_PSEL(TWIM_SCL, 0, 8)>;
    //         bias-pull-up;
    //     };
    // };

    // i2c0_sleep: i2c0_sleep {
    //     group1 {
    //         psels = <NRF_PSEL(TWIM_SDA, 0, 7)>,
    //                 <NRF_PSEL(TWIM_SCL, 0, 8)>;
    //         low-power-enable;
    //     };
    // };

    uart0_default: uart0_default {
        group1 {
        
            // Active pin state - TX on P0.06, RX on P0.11
            psels = <NRF_PSEL(UART_TX, 0, 6)>,
                    <NRF_PSEL(UART_RX, 0, 11)>;
        };
    };
    uart0_sleep: uart0_sleep {
        group1 {

            // Sleep pin state - same pins but low power mode enabled
            psels = <NRF_PSEL(UART_TX, 0, 6)>,
                    <NRF_PSEL(UART_RX, 0, 11)>;
            low-power-enable;
        };
    };

    i2c1_default: i2c1_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 26)>,
                    <NRF_PSEL(TWIM_SCL, 0, 27)>;
        };
    };

    i2c1_sleep: i2c1_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 26)>,
                    <NRF_PSEL(TWIM_SCL, 0, 27)>;
            low-power-enable;
        };
    };

    spi2_default: spi2_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 15)>,
				<NRF_PSEL(SPIM_MOSI, 0, 13)>;
		};
	};
	spi2_sleep: spi2_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 15)>,
				<NRF_PSEL(SPIM_MOSI, 0, 13)>;
		};
	};

};

//SPI for eink display - change pins to whatever is on the schematic for eink
&spi2 {
        compatible = "nordic,nrf-spi";
        status = "okay";
        pinctrl-0 = <&spi2_default>;
        pinctrl-1 = <&spi2_sleep>;
        pinctrl-names = "default", "sleep";
        
        gendev: gendev@0 {
                compatible = "vnd,spi-device";
                reg = <0>;
                spi-max-frequency = <2000000>;
                label = "GenDev";
        };
};

/* UART0 peripheral configuration - used for FP data at 115200 baud */
&uart0 {
    status = "okay";
    current-speed = <115200>;
    // state 0: active
    pinctrl-0 = <&uart0_default>;
    // state 1: sleep
    pinctrl-1 = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";
};

// i2c0: BMU READS: change "disabled" to "okay"
&i2c0 {
    status = "disabled";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    compatible = "nordic,nrf-twim";

    zephyr,concat-buf-size = <512>;
    zephyr,flash-buf-max-size = <512>;
};

// disable spi1 so we can use i2c1
&spi1 {
    status = "disabled";
};

&i2c1 {
    status = "okay";
    pinctrl-0 = <&i2c1_default>;
    pinctrl-1 = <&i2c1_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    compatible = "nordic,nrf-twim";
    
    zephyr,concat-buf-size = <512>;
    zephyr,flash-buf-max-size = <512>;
};

